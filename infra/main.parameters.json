{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=eastasia}" },
    "cosmosLocation": { "value": "${COSMOS_LOCATION=southeastasia}" },
    "foundryLocation": { "value": "${FOUNDRY_LOCATION=eastus2}" },
    "customerName": { "value": "${CUSTOMER_NAME=skyflow}" },
    "environmentType": { "value": "${ENVIRONMENT_TYPE=dev}" },
    "swaSku": { "value": "${SWA_SKU=Standard}" },
    "monthlyBudgetUsd": { "value": 10000 },
    "budgetContactEmails": { "value": ["${BUDGET_CONTACT_EMAIL}"] },
    "deployModels": { "value": "${DEPLOY_MODELS=true}" },
    "primaryModelName": { "value": "${FOUNDRY_MODEL_PRIMARY=gpt-4.1}" },
    "primaryModelVersion": { "value": "${FOUNDRY_MODEL_PRIMARY_VERSION=2025-04-14}" },
    "primaryModelSku": { "value": "${FOUNDRY_MODEL_PRIMARY_SKU=GlobalStandard}" },
    "primaryModelCapacity": { "value": "${FOUNDRY_MODEL_PRIMARY_CAPACITY=50}" },
    "fastModelName": { "value": "${FOUNDRY_MODEL_FAST=gpt-4.1-mini}" },
    "fastModelVersion": { "value": "${FOUNDRY_MODEL_FAST_VERSION=2025-04-14}" },
    "fastModelSku": { "value": "${FOUNDRY_MODEL_FAST_SKU=GlobalStandard}" },
    "fastModelCapacity": { "value": "${FOUNDRY_MODEL_FAST_CAPACITY=100}" },
    "enableContentSafety": { "value": "${ENABLE_CONTENT_SAFETY=true}" },
    "enableMonitoringAlerts": { "value": "${ENABLE_MONITORING_ALERTS=true}" },
    "linkSwaBackend": { "value": "${LINK_SWA_BACKEND=true}" },
    "enablePrivateNetworking": { "value": "${ENABLE_PRIVATE_NETWORKING=false}" },
    "enablePurgeProtection": { "value": "${ENABLE_PURGE_PROTECTION=true}" },
    "cosmosServerless": { "value": "${COSMOS_SERVERLESS=true}" },
    "aadClientId": { "value": "${AAD_CLIENT_ID=}" },
    "aadClientSecret": { "value": "${AAD_CLIENT_SECRET=}" },
    "authDisabled": { "value": "${AUTH_DISABLED=auto}" },
    "apiAudience": { "value": "${API_AUDIENCE=}" },
    "teamsWebhookUrl": { "value": "${TEAMS_WEBHOOK_URL=}" },
    "engineMcpExists": { "value": "${SERVICE_ENGINE_MCP_RESOURCE_EXISTS=false}" },
    "agentApiExists": { "value": "${SERVICE_AGENT_API_RESOURCE_EXISTS=false}" },
    "schedulerExists": { "value": "${SERVICE_SCHEDULER_RESOURCE_EXISTS=false}" }
  }
}
